msgid ""
msgstr ""
"Content-Type: text/plain; charset=UTF-8\n"
"Language: zh_Hans\n"

msgid "OpenWrt to MQTT"
msgstr "OpenWrt to MQTT"

msgid "Configure MQTT and enable the service. Advanced options already have safe defaults."
msgstr "配置 MQTT 服务器并启用服务。高级选项已提供安全的默认值。"

msgid "Status"
msgstr "运行状态"

msgid "Service"
msgstr "服务"

msgid "Running"
msgstr "运行中"

msgid "Not running"
msgstr "未运行"

msgid "Disabled"
msgstr "已停用"

msgid "MQTT configuration"
msgstr "MQTT 配置"

msgid "Configured"
msgstr "已配置"

msgid "Not configured"
msgstr "尚未配置"

msgid "Version"
msgstr "版本"

msgid "Unknown"
msgstr "未知"

msgid "Reload service"
msgstr "重载服务"

msgid "Service reload failed."
msgstr "服务重载失败。"

msgid "Service reloaded successfully."
msgstr "服务已成功重载。"

msgid "Settings"
msgstr "设置"

msgid "Quick setup"
msgstr "常用设置"

msgid "Event settings"
msgstr "事件设置"

msgid "Advanced settings"
msgstr "高级设置"

msgid "Enable service"
msgstr "启用服务"

msgid "MQTT server"
msgstr "MQTT 服务器"

msgid "Enter a host and port. tcp:// is added automatically when no protocol is specified."
msgstr "请输入主机和端口；未指定协议时会自动添加 tcp://。"

msgid "Username"
msgstr "用户名"

msgid "Password"
msgstr "密码"

msgid "Leave empty to keep the saved password."
msgstr "留空表示保持已保存的密码不变。"

msgid "Test connection"
msgstr "测试连接"

msgid "MQTT connection succeeded in %d ms."
msgstr "MQTT 连接成功，耗时 %d 毫秒。"

msgid "The saved MQTT configuration is invalid."
msgstr "已保存的 MQTT 配置无效。"

msgid "The MQTT connection timed out."
msgstr "MQTT 连接超时。"

msgid "The MQTT connection failed."
msgstr "MQTT 连接失败。"

msgid "The MQTT connection test failed."
msgstr "MQTT 连接测试失败。"

msgid "Device connection"
msgstr "设备接入"

msgid "Publish an event after a device obtains a DHCP address. Normal renewals are ignored."
msgstr "设备通过 DHCP 获取地址后发布接入事件，正常续租不会重复发布。"

msgid "View message example"
msgstr "查看消息示例"

msgid "Capture interface"
msgstr "监听接口"

msgid "The capture interface must not be empty."
msgstr "监听接口不能为空。"

msgid "Device connection message example"
msgstr "设备接入消息示例"

msgid "MQTT topic example"
msgstr "MQTT 主题示例"

msgid "Topic structure: topic prefix/router ID/event category/event type. Actual values depend on the device configuration."
msgstr "主题结构：主题前缀/路由器标识/事件分类/事件类型。实际值以设备配置为准。"

msgid "Message example"
msgstr "消息示例"

msgid "Field description"
msgstr "字段说明"

msgid "Message schema version, currently 1."
msgstr "消息结构版本，当前为 1。"

msgid "Unique event identifier."
msgstr "事件唯一标识。"

msgid "Router identifier that produced the event."
msgstr "产生事件的路由器标识。"

msgid "Event category. Device connection events use network."
msgstr "事件分类，设备接入使用 network。"

msgid "Event type. Device connection events use device.connected."
msgstr "事件类型，设备接入使用 device.connected。"

msgid "Event source in the form dhcp/capture interface."
msgstr "事件来源，格式为 dhcp/监听接口。"

msgid "UTC time when the event was generated."
msgstr "事件生成时的 UTC 时间。"

msgid "Event-specific data."
msgstr "当前事件的专属数据。"

msgid "Device MAC address."
msgstr "接入设备的 MAC 地址。"

msgid "DHCP transaction identifier."
msgstr "DHCP 事务标识。"

msgid "IP address assigned to the device."
msgstr "分配给设备的 IP 地址。"

msgid "Hostname supplied by the device through DHCP."
msgstr "设备通过 DHCP 提供的主机名。"

msgid "DHCP server address."
msgstr "DHCP 服务器地址。"

msgid "mac and transaction_id are always present. ip, hostname, and server_ip are optional and may be absent from actual messages."
msgstr "mac 和 transaction_id 始终存在；ip、hostname 和 server_ip 为可选字段，实际消息中可能不存在。"

msgid "Log level"
msgstr "日志级别"

msgid "Debug"
msgstr "调试"

msgid "Info"
msgstr "信息"

msgid "Warning"
msgstr "警告"

msgid "Error"
msgstr "错误"

msgid "Event queue capacity"
msgstr "事件队列容量"
