msgid "View message example"
msgstr "查看消息示例"

msgid "Message example"
msgstr "消息示例"

msgid "OpenWrt to MQTT"
msgstr "OpenWrt to MQTT"

msgid "Publish OpenWrt system events to MQTT."
msgstr "将OpenWrt系统事件发布到MQTT"

msgid "Status"
msgstr "运行状态"

msgid "Service"
msgstr "服务"

msgid "Running"
msgstr "运行中"

msgid "Not running"
msgstr "未运行"

msgid "Disabled"
msgstr "已停用"

msgid "MQTT configuration"
msgstr "MQTT 配置"

msgid "Configured"
msgstr "已配置"

msgid "Not configured"
msgstr "尚未配置"

msgid "Version"
msgstr "版本"

msgid "Unknown"
msgstr "未知"

msgid "Reload service"
msgstr "重载服务"

msgid "Service reload failed."
msgstr "服务重载失败。"

msgid "Service reloaded successfully."
msgstr "服务已成功重载。"

msgid "Settings"
msgstr "设置"

msgid "Quick setup"
msgstr "常用设置"

msgid "Event settings"
msgstr "事件设置"

msgid "Advanced settings"
msgstr "高级设置"

msgid "Enable service"
msgstr "启用服务"

msgid "MQTT server"
msgstr "MQTT 服务器"

msgid "Enter a host and port. tcp:// is added automatically when no protocol is specified."
msgstr "请输入主机和端口；未指定协议时会自动添加 tcp://。"

msgid "Username"
msgstr "用户名"

msgid "Password"
msgstr "密码"

msgid "Test connection"
msgstr "测试连接"

msgid "MQTT connection succeeded in %d ms."
msgstr "MQTT 连接成功，耗时 %d 毫秒。"

msgid "The saved MQTT configuration is invalid."
msgstr "已保存的 MQTT 配置无效。"

msgid "The MQTT connection timed out."
msgstr "MQTT 连接超时。"

msgid "The MQTT connection failed."
msgstr "MQTT 连接失败。"

msgid "The MQTT connection test failed."
msgstr "MQTT 连接测试失败。"

msgid "Device connection"
msgstr "设备接入"

msgid "Publish device connection and disconnection events from Wi-Fi, DHCP, and IPv4 neighbor state. Duplicate state events are ignored."
msgstr "通过 Wi-Fi、DHCP 和 IPv4 邻居状态发布设备接入与离线事件，重复状态不会重复发布。"

msgid "Publish an event when a device is first observed or reconnects."
msgstr "首次发现设备或设备重新连接时发布接入事件。"

msgid "Device disconnection"
msgstr "设备断开"

msgid "Publish an event after a device remains unreachable for the configured offline time."
msgstr "设备持续不可达达到设定离线时间后发布断开事件。"

msgid "Offline time (seconds)"
msgstr "离线时间（秒）"

msgid "Offline time must be a positive integer number of seconds."
msgstr "离线时间必须为大于零的整数秒。"

msgid "Capture interface"
msgstr "监听接口"

msgid "The capture interface must not be empty."
msgstr "监听接口不能为空。"

msgid "Log level"
msgstr "日志级别"

msgid "Debug"
msgstr "调试"

msgid "Info"
msgstr "信息"

msgid "Warning"
msgstr "警告"

msgid "Error"
msgstr "错误"

msgid "Event queue capacity"
msgstr "事件队列容量"
